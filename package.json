{
  "name": "video-editor-poc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "vite build",
    "server": "node server/render-server.mjs",
    "media": "node scripts/make-test-media.mjs",
    "typecheck": "tsc --noEmit",
    "twick-assets": "node node_modules/@twick/browser-render/scripts/copy-public-assets.js",
    "ui-check": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@twick/browser-render": "^0.15.31",
    "@twick/canvas": "^0.15.31",
    "@twick/live-player": "^0.15.31",
    "@twick/studio": "^0.15.31",
    "@twick/timeline": "^0.15.31",
    "@twick/video-editor": "^0.15.31",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "ffmpeg-static": "^5.3.0",
    "mediabunny": "^1.66.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.6"
  },
  "description": "Proof of concept: in-browser video editor (own core + server FFmpeg + Mediabunny) compared with Twick"
}
